# =============================================================================
# SKILL2JOB.AI — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# =============================================================================
# Enterprise AI-Powered Campus Recruitment & Skill Verification Platform
#
# =============================================================================
# 1. DATABASE & PERSISTENCE (Prisma ORM with PostgreSQL)
# =============================================================================
# PostgreSQL connection string (supports Neon, Supabase, AWS RDS, Docker, local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill2job?schema=public"

# =============================================================================
# 2. SECURITY & SESSION SECRETS (REQUIRED)
# =============================================================================
# Generate a secure 256-bit secret (e.g. using `openssl rand -base64 32`)
JWT_SECRET=your_jwt_secret_here_min_32_characters
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# 3. AI & LLM ENGINE (Google Gemini 2.0 Flash)
# =============================================================================
# Obtain your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# 4. DISTRIBUTED AI CACHING (Upstash Redis L2 Cache)
# =============================================================================
# Optional distributed cache tier for expensive AI evaluations
# If omitted, system falls back to in-memory L1 LRU cache seamlessly.
# UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# =============================================================================
# 5. RATE LIMITING & SECURITY SHIELD (Arcjet)
# =============================================================================
# Enterprise API rate limiter and prompt-injection guard
# ARCJET_KEY=ajkey_your_arcjet_api_key_here

# =============================================================================
# 6. OBSERVABILITY & ERROR TRACKING (Sentry)
# =============================================================================
# Real-time error capture and structured performance monitoring
# SENTRY_DSN=https://your_sentry_key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_key@o0.ingest.sentry.io/0

# =============================================================================
# 7. TRANSACTIONAL EMAIL NOTIFICATIONS & OTP
# =============================================================================
# OPTION A: Resend (Recommended, easiest setup: https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Skill2Job.ai <notifications@skill2job.ai>"

# OPTION B: Standard SMTP (Gmail App Password, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_SECURE=false

# =============================================================================
# 8. SMS OTP PROVIDER (Twilio / MSG91 / Fast2SMS)
# =============================================================================
# OPTION A: Twilio SMS (https://twilio.com)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# 9. SECURE CLOUD STORAGE PROVIDER (AWS S3, Supabase Storage, Vercel Blob)
# =============================================================================
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# =============================================================================
# 10. REMOTE CODE EXECUTION SANDBOX (Piston / Judge0)
# =============================================================================
# If omitted, local isolated sandbox (Node.js VM / Python runner) is used.
# PISTON_API_URL=http://localhost:2000/api/v2/piston/execute
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_judge0_rapidapi_key
