# =============================================================================
# SKILL2HIRE — PRODUCTION OTP & AUTHENTICATION CONFIGURATION (.env)
# =============================================================================
#
# Configure your REAL Email and SMS providers below.
# The application automatically detects and uses the configured provider.
#
# =============================================================================
# 1. TRANSACTIONAL EMAIL OTP PROVIDER (Choose ONE Option)
# =============================================================================

# OPTION A: Resend (Recommended, easiest setup: https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Skill2Hire <onboarding@resend.dev>"

# OPTION B: Standard SMTP (Works with Gmail App Passwords, Outlook, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_SECURE=false
# EMAIL_FROM="Skill2Hire <your_email@gmail.com>"

# OPTION C: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_api_key_here
# EMAIL_FROM="Skill2Hire <noreply@yourdomain.com>"


# =============================================================================
# 2. SMS OTP PROVIDER (Choose ONE Option)
# =============================================================================

# OPTION A: Twilio SMS (https://twilio.com)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890
# Or use Twilio Messaging Service SID:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTION B: MSG91 (India / Global SMS: https://msg91.com)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_dlt_approved_template_id

# OPTION C: Fast2SMS (India Quick SMS: https://fast2sms.com)
# FAST2SMS_API_KEY=your_fast2sms_api_key


# =============================================================================
# 3. SECURITY & SESSION SECRETS (REQUIRED - App refuses to start without JWT_SECRET)
# =============================================================================
# Generate a secure 256-bit secret (e.g. using `openssl rand -base64 32`)
JWT_SECRET=your_jwt_secret_here_min_32_characters
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# 4. SECURE CLOUD STORAGE PROVIDER (AWS S3, Supabase Storage, Vercel Blob)
# =============================================================================
# OPTION A: AWS S3 / Supabase Storage (S3-compatible) / Cloudflare R2
# Presigned URLs are generated automatically for private buckets.
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3 # (Optional: Supabase/MinIO/R2)

# OPTION B: Vercel Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# =============================================================================
# 5. REMOTE SANDBOX CODE EXECUTION ENGINE (Optional: Piston / Judge0)
# =============================================================================
# If not set, code execution automatically uses local secure isolated sandboxing
# (Node.js vm context for JavaScript and isolated subprocess sandbox with timeouts for Python).
#
# OPTION A: Piston Sandbox (Self-hosted instance: https://github.com/engineer-man/piston)
# PISTON_API_URL=http://localhost:2000/api/v2/piston/execute
#
# OPTION B: Judge0 Sandbox (RapidAPI or self-hosted: https://judge0.com)
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_judge0_rapidapi_key

# =============================================================================
# 6. GOOGLE GEMINI AI CONFIGURATION (Configurable LLM Model)
# =============================================================================
# Obtain your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Configurable Gemini model name (default: gemini-2.0-flash)
# Supported: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-2.0-flash
